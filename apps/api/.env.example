# Salin berkas ini menjadi `.env` lalu sesuaikan nilainya.
# Berkas `.env` asli tidak boleh di-commit.

# Koneksi PostgreSQL 17 lokal
DATABASE_URL="postgresql://sialokasi:sialokasi_dev@127.0.0.1:5432/sialokasi?schema=public"

# Server API
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
# Di Vercel/Railway di belakang proxy: true
TRUST_PROXY=false

# Alamat web saat pengembangan (untuk izin CORS)
WEB_ORIGIN=http://localhost:5173

# Saat true: kode masuk demo 123456 selalu diterima dan panel /dev aktif
DEMO_MODE=true
