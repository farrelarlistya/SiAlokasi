// Skema database SiAlokasi — mengikuti PRD §6.1.
// Uang tidak dipakai di aplikasi ini; semua kuantitas bantuan adalah integer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PETUGAS
  PIMPINAN
  ADMIN
}

enum IncidentStatus {
  BARU
  DIPERIKSA
  MENUNGGU_PERSETUJUAN
  DISETUJUI
  SELESAI
  DITOLAK
  DIBATALKAN
}

enum DisasterType {
  BANJIR
  KEBAKARAN
  GEMPA
  ANGIN
  LAINNYA
}

enum DamageLevel {
  RINGAN
  SEDANG
  BERAT
}

enum RoadAccess {
  TERBUKA
  TERBATAS
  TERPUTUS
}

enum WeatherCondition {
  CERAH
  HUJAN
  EKSTREM
}

enum DensityLevel {
  RENDAH
  SEDANG
  TINGGI
}

enum DecisionType {
  APPROVE
  REJECT
}

enum PermitStatus {
  TERBIT
  DICETAK
  SELESAI
  DIBATALKAN
}

enum StockMovementKind {
  RESERVE
  RELEASE
  ADJUST
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String?
  role         Role
  isActive  Boolean  @default(true)
  regionId  String?
  region    Region?  @relation(fields: [regionId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  incidents      Incident[]           @relation("IncidentReporter")
  incidentLogs   IncidentLog[]        @relation("IncidentLogActor")
  decisions      Decision[]           @relation("DecisionDecider")
  permits        Permit[]             @relation("PermitIssuer")
  auditLogs      AuditLog[]           @relation("AuditActor")
  sessions       Session[]
  stockMovements StockMovement[]
  corrections    IncidentCorrection[]
  notifications  Notification[]

  @@index([role, isActive])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@map("sessions")
}

model Region {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  poskos    Posko[]
  incidents Incident[]
  users     User[]

  @@map("regions")
}

model Posko {
  id        String   @id @default(cuid())
  name      String   @unique
  regionId  String
  region    Region   @relation(fields: [regionId], references: [id])
  lat       Float
  lng       Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stocks    Stock[]
  permits   Permit[]
  movements StockMovement[]

  @@map("poskos")
}

model AidItem {
  id                String   @id @default(cuid())
  name              String   @unique
  unit              String
  icon              String
  standardPerPerson Float    @default(0)
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())

  recommendationItems RecommendationItem[]
  permitItems         PermitItem[]
  stocks              Stock[]
  movements           StockMovement[]

  @@map("aid_items")
}

model Incident {
  id             String         @id @default(cuid())
  code           String         @unique
  title          String
  disasterType   DisasterType
  disasterDetail String?
  lat            Float
  lng            Float
  radiusM        Int
  regionId       String?
  region         Region?        @relation(fields: [regionId], references: [id])
  occurredAt     DateTime
  status         IncidentStatus @default(BARU)
  reporterId     String
  reporter       User           @relation("IncidentReporter", fields: [reporterId], references: [id])
  cancelReason   String?

  affectedPeople     Int?
  damageLevel        DamageLevel?
  vulnerableBabies   Int               @default(0)
  vulnerableElderly  Int               @default(0)
  vulnerablePregnant Int               @default(0)
  vulnerableDisabled Int               @default(0)
  roadAccess         RoadAccess?
  weather            WeatherCondition?
  density            DensityLevel?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs            IncidentLog[]
  recommendations Recommendation[]
  permits         Permit[]
  corrections     IncidentCorrection[]
  notifications   Notification[]

  @@index([status, occurredAt])
  @@map("incidents")
}

model IncidentLog {
  id         String          @id @default(cuid())
  incidentId String
  incident   Incident        @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  fromStatus IncidentStatus?
  toStatus   IncidentStatus
  actorId    String?
  actor      User?           @relation("IncidentLogActor", fields: [actorId], references: [id])
  note       String?
  createdAt  DateTime        @default(now())

  @@index([incidentId, createdAt])
  @@map("incident_logs")
}

model Recommendation {
  id           String   @id @default(cuid())
  incidentId   String
  incident     Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  modelVersion String
  totalPeople  Int
  isActive     Boolean  @default(true)
  generatedAt  DateTime @default(now())

  items     RecommendationItem[]
  decisions Decision[]

  @@index([incidentId, isActive])
  @@map("recommendations")
}

model RecommendationItem {
  id               String         @id @default(cuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  aidItemId        String
  aidItem          AidItem        @relation(fields: [aidItemId], references: [id])
  baseQty          Int
  finalQty         Int
  unit             String
  reason           String
  adjustReason     String?

  @@unique([recommendationId, aidItemId])
  @@map("recommendation_items")
}

model Decision {
  id               String         @id @default(cuid())
  recommendationId String
  recommendation   Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
  deciderId        String
  decider          User           @relation("DecisionDecider", fields: [deciderId], references: [id])
  decision         DecisionType
  reason           String?
  decidedAt        DateTime       @default(now())

  @@unique([recommendationId])
  @@map("decisions")
}

model Permit {
  id         String       @id @default(cuid())
  number     String       @unique
  incidentId String
  incident   Incident     @relation(fields: [incidentId], references: [id])
  poskoId    String
  posko      Posko        @relation(fields: [poskoId], references: [id])
  issuedById String
  issuedBy   User         @relation("PermitIssuer", fields: [issuedById], references: [id])
  issuedAt   DateTime     @default(now())
  validUntil DateTime?
  status     PermitStatus @default(TERBIT)

  /**
   * Penanda koreksi: izin lama digantikan izin baru, bukan dihapus.
   */
  supersededAt       DateTime?
  supersededByNumber String?
  replacesNumber     String?

  items               PermitItem[]
  movements           StockMovement[]
  correctionsPrevious IncidentCorrection[] @relation("CorrectionPreviousPermit")
  correctionsNew      IncidentCorrection[] @relation("CorrectionNewPermit")
  notifications       Notification[]

  @@index([incidentId])
  @@map("permits")
}

/// Salinan daftar bantuan saat izin diterbitkan, agar dokumen lama tidak berubah.
model PermitItem {
  id        String  @id @default(cuid())
  permitId  String
  permit    Permit  @relation(fields: [permitId], references: [id], onDelete: Cascade)
  aidItemId String
  aidItem   AidItem @relation(fields: [aidItemId], references: [id])
  name      String
  unit      String
  qty       Int
  reason    String?

  @@unique([permitId, aidItemId])
  @@map("permit_items")
}

model Stock {
  id        String   @id @default(cuid())
  poskoId   String
  posko     Posko    @relation(fields: [poskoId], references: [id])
  aidItemId String
  aidItem   AidItem  @relation(fields: [aidItemId], references: [id])
  qty       Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([poskoId, aidItemId])
  @@map("stocks")
}

/// Jurnal stok append-only. Setiap pengurangan/penambahan meninggalkan baris,
/// sehingga angka stok selalu bisa ditelusuri kembali.
model StockMovement {
  id           String            @id @default(cuid())
  poskoId      String
  posko        Posko             @relation(fields: [poskoId], references: [id])
  aidItemId    String
  aidItem      AidItem           @relation(fields: [aidItemId], references: [id])
  qtyDelta     Int
  balanceAfter Int
  kind         StockMovementKind
  permitId     String?
  permit       Permit?           @relation(fields: [permitId], references: [id])
  actorId      String?
  actor        User?             @relation(fields: [actorId], references: [id])
  note         String?
  createdAt    DateTime          @default(now())

  @@index([poskoId, aidItemId, createdAt])
  @@index([permitId])
  @@map("stock_movements")
}

/// Catatan koreksi pasca-persetujuan. Izin lama tetap tersimpan, ditandai
/// digantikan, dan seluruh perubahan jumlah tercatat di `changes`.
model IncidentCorrection {
  id               String   @id @default(cuid())
  incidentId       String
  incident         Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  previousPermitId String
  previousPermit   Permit   @relation("CorrectionPreviousPermit", fields: [previousPermitId], references: [id])
  newPermitId      String
  newPermit        Permit   @relation("CorrectionNewPermit", fields: [newPermitId], references: [id])
  reason           String
  changes          Json
  actorId          String
  actor            User     @relation(fields: [actorId], references: [id])
  createdAt        DateTime @default(now())

  @@index([incidentId, createdAt])
  @@map("incident_corrections")
}

/// Notifikasi simulasi in-app. Satu baris untuk satu penerima pada satu peristiwa.
/// Tidak mengirim WA/SMS asli; halaman Notifikasi menjadi log yang bisa dibaca ulang.
model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  title      String
  body       String
  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  permitId   String?
  permit     Permit?   @relation(fields: [permitId], references: [id], onDelete: SetNull)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, readAt, createdAt])
  @@index([incidentId])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  action    String
  actorId   String?
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@map("audit_logs")
}

model DemoClock {
  id            Int      @id @default(1)
  offsetMinutes Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@map("demo_clock")
}
