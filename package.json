{
  "name": "sialokasi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SiAlokasi — alur laporan lapangan sampai izin distribusi bantuan bencana",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @sialokasi/api",
    "dev:web": "npm run dev -w @sialokasi/web",
    "build": "npm run typecheck -w @sialokasi/shared && npm run typecheck -w @sialokasi/api && npm run build -w @sialokasi/web",
    "test": "npm run test -w @sialokasi/shared",
    "model:train": "node tools/train-model/train.mjs",
    "verify:m1": "npm run verify:m1 -w @sialokasi/api",
    "verify:m2": "npm run verify:m2 -w @sialokasi/api",
    "verify:m3": "npm run verify:m3 -w @sialokasi/api",
    "verify:m4": "npm run verify:m4 -w @sialokasi/api",
    "verify:m5": "npm run verify:m5 -w @sialokasi/api",
    "verify:login": "node scripts/check-login-switch.mjs",
    "share": "node scripts/share.mjs",
    "share:cloudflare": "node scripts/share-cloudflare.mjs",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:status": "node scripts/db.mjs status",
    "db:migrate": "npm run db:migrate -w @sialokasi/api",
    "db:seed": "npm run db:seed -w @sialokasi/api",
    "db:studio": "npm run db:studio -w @sialokasi/api",
    "demo:reset": "npm run demo:reset -w @sialokasi/api"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "esbuild": "^0.25.10",
    "localtunnel": "^2.0.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3"
  }
}
